# Telegram
TELEGRAM_BOT_TOKEN=          # From BotFather — keep secret
TELEGRAM_WEBHOOK_SECRET=     # Random hex string for webhook validation
TELEGRAM_SETUP_SECRET=       # One-time setup key — regenerate after use

# Storage: Vercel Blob. A linked store sets this automatically; KV overrides it when both are set.
BLOB_READ_WRITE_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Conversational layer: free text answers, grounded in the live on-chain reads.
# Without a key the bot answers free text with the command list instead.
DEEPSEEK_API_KEY=

# Monitoring cron (set on the pm2 sessia-cron process)
SESSIA_CRON_SECRET=          # Must match CRON_SECRET in Vercel env

# CRON_SECRET on Vercel (authorizes /api/monitor calls)
CRON_SECRET=

# Daily allowances (optional, these are the defaults)
TELEGRAM_DAILY_LIMIT=10      # messages one Telegram chat may send per UTC day
WALLET_DAILY_LIMIT=5         # answers one signed wallet gets per UTC day
GLOBAL_DAILY_LIMIT=500       # product wide ceiling for the whole day

# Optional: BNB Chain RPC for the wallet history check
BSC_RPC_URL=

# Optional: signed Binance Web3 API (aggregated quotes, swaps).
# Market data (registry, session, issuer prices) needs no key. Without these two the
# signed path is simply absent: /api/health reports web3ApiSigned false.
W3W_API_KEY=
W3W_SECRET_KEY=

# Optional: bot profile photo (base64-encoded PNG, set once)
BOT_PHOTO_B64=

# Optional: agent identity (BNB Agent Studio). Set after registering the card with
# `bag erc8004 register`; the well known card publishes the registration on its own.
SESSIA_AGENT_ID=
SESSIA_IDENTITY_REGISTRY=
SESSIA_AGENT_CHAIN_ID=

# Optional: the x402 paywall on /api/agent/research. Without a payee the route answers
# 503 with what it would have charged instead of a 402 challenge.
X402_PAY_TO=
X402_FACILITATOR_URL=
X402_NETWORK=
X402_ASSET=
X402_ASSET_SYMBOL=
X402_ASSET_NAME=
X402_ASSET_VERSION=
X402_ASSET_DECIMALS=
