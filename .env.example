# Telegram
TELEGRAM_BOT_TOKEN=          # From BotFather — keep secret
TELEGRAM_WEBHOOK_SECRET=     # Random hex string for webhook validation
TELEGRAM_SETUP_SECRET=       # One-time setup key — regenerate after use

# Vercel KV (Redis) — create store at vercel.com/dashboard → Storage → KV
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Monitoring cron (set on the pm2 sessia-cron process)
SESSIA_CRON_SECRET=          # Must match CRON_SECRET in Vercel env

# CRON_SECRET on Vercel (authorizes /api/monitor calls)
CRON_SECRET=

# Optional: bot profile photo (base64-encoded PNG, set once)
BOT_PHOTO_B64=
